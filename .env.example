# Copy to .env and adjust. All values have safe local defaults.

# Host ports (change if something else already listens there)
API_PORT=8080
CLIENT_PORT=8081
ADMIN_PORT=8082
WORKER_PORT=8083
REDIS_PORT=6380
DYNAMODB_PORT=8000
SQS_PORT=9324
SQS_UI_PORT=9325

# URL the browser uses to reach the API (baked into the client build)
PUBLIC_API_URL=http://localhost:8080

# Secrets — MUST be changed outside local development
ADMIN_TOKEN=local-admin-token
TOKEN_SECRET=dev-secret-change-me

LOG_LEVEL=info
VERSION=local
