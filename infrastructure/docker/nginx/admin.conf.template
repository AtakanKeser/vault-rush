# Rendered by the nginx image's envsubst hook into /etc/nginx/conf.d/default.conf.
# Substituted variables: ${LISTEN_PORT}, ${API_UPSTREAM} (see NGINX_ENVSUBST_FILTER).
#
# Proxied to the API (same-origin for the dashboard):
#   /admin/   -> ${API_UPSTREAM}/admin/   (LiveOps API, X-Admin-Token is passed through)
#   /healthz  /readyz  /metrics           (system panel)

server {
    listen       ${LISTEN_PORT};
    listen  [::]:${LISTEN_PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    server_tokens off;
    absolute_redirect off;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/javascript application/javascript
                      application/json application/manifest+json image/svg+xml font/woff2;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /_nginx/health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- API proxy --------------------------------------------------------------
    # ${API_UPSTREAM} is a literal after envsubst, so nginx resolves it once at startup.
    # In compose this means the api service must be resolvable when admin starts
    # (depends_on). No trailing slash on proxy_pass: the original URI is forwarded intact.

    location ^~ /admin/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Request-Id      $request_id;
        proxy_set_header   Connection        "";
        proxy_read_timeout 30s;
        proxy_buffering    off;
    }

    location = /healthz { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $host; access_log off; }
    location = /readyz  { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $host; access_log off; }
    location = /metrics { proxy_pass ${API_UPSTREAM}; proxy_set_header Host $host; }

    # ---- static SPA ------------------------------------------------------------------

    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
