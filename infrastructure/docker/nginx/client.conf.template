# Rendered by the nginx image's envsubst hook into /etc/nginx/conf.d/default.conf.
# Substituted variables: ${LISTEN_PORT}, ${API_UPSTREAM} (see NGINX_ENVSUBST_FILTER).

server {
    listen       ${LISTEN_PORT};
    listen  [::]:${LISTEN_PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    server_tokens off;
    absolute_redirect off;

    # Compression for text assets. Hashed bundles are already small enough that brotli
    # is not worth an extra module here.
    gzip              on;
    gzip_vary         on;
    gzip_comp_level   5;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/javascript application/javascript
                      application/json application/manifest+json image/svg+xml
                      font/woff2 application/wasm;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Container liveness (used by docker-compose / HEALTHCHECK). Not the API's /healthz.
    location = /_nginx/health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite emits content-hashed filenames under /assets/, so they can be cached forever.
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The API is called directly by the browser (CORS_ORIGINS on the API). Proxying
    # /v1/ here instead makes the client same-origin; uncomment if preferred.
    # location ^~ /v1/ {
    #     proxy_pass         ${API_UPSTREAM};
    #     proxy_http_version 1.1;
    #     proxy_set_header   Host              $host;
    #     proxy_set_header   X-Real-IP         $remote_addr;
    #     proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    #     proxy_set_header   X-Forwarded-Proto $scheme;
    #     proxy_set_header   X-Request-Id      $request_id;
    # }

    # SPA fallback: unknown paths render index.html so client-side routing works.
    # index.html itself must never be cached so a deploy is picked up immediately.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
